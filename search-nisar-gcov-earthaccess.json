xample was copied from the ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"x23ZmqLlNJ"},{"type":"link","url":"https://nisar-docs.asf.alaska.edu/earthaccess/","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"NISAR Data User Guide","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"hwiwv7svGm"}],"urlSource":"https://nisar-docs.asf.alaska.edu/earthaccess/","key":"fxaXctJwm6"}],"key":"fUtivI8rfc"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Direct S3 access only works when running in the AWS ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"GqTzsH81yI"},{"type":"inlineCode","value":"us-west-2","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"wnTd8hoH99"},{"type":"text","value":" region.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"gPHVYvoAgh"}],"key":"O3t7kdBT8D"}],"key":"a68gsPpw1S"}],"identifier":"1e071dbc-fe02-4cf4-9bea-0a5aa10794d9","html_id":"1e071dbc-fe02-4cf4-9bea-0a5aa10794d9","key":"hoTw0ctJ6X"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Notes on Chunking","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kxXbVJvzzc"}],"identifier":"notes-on-chunking","label":"Notes on Chunking","html_id":"notes-on-chunking","implicit":true,"key":"xPouhCPoBf"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This notebook utilizes chunking to break large arrays into smaller blocks. Chunking allows users to inspect and process subsets of a dataset without loading entire arrays into memory at once. In this example, data are accessed using an 8 MB block size for cloud access.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"cY7PPQ4UnX"}],"key":"i70Gv9TNJO"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"For additional benchmarking and recommendations for NISAR direct-access workflows, see Henry Rodman’s ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"OeRnMGhf9P"},{"type":"link","url":"https://gist.github.com/hrodmn/5a377531c19da6f6d2c2bb149c450b3d","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Reading NISAR granules directly from S3","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"h5R8P7nQxo"}],"urlSource":"https://gist.github.com/hrodmn/5a377531c19da6f6d2c2bb149c450b3d","key":"PxVqRCXpFQ"},{"type":"text","value":".","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"lJpJ1Q4qfe"}],"key":"fOWFiIxb6X"}],"identifier":"5c828ed3-a277-4535-832c-033b095a3176","html_id":"5c828ed3-a277-4535-832c-033b095a3176","key":"ECWrZS4LmR"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"%%time\n\nimport earthaccess\nimport xarray as xr\n\ns3_links = results[0].data_links(access='direct')\n\nfsspec_config = {\n    'cache_type': 'background',\n    'block_size': 8*1024*1024,  # 8 MB\n}\n\n# The endpoint must be set to the NISAR-specific endpoint\nendpoint = 'https://nisar.asf.earthdatacloud.nasa.gov/s3credentials'\nfs = earthaccess.get_s3_filesystem(endpoint=endpoint)\nds = xr.open_datatree(\n   fs.open(s3_links[0], **fsspec_config),\n   engine='h5netcdf',\n   decode_timedelta=False,\n   phony_dims=\"access\"\n)\n\nds","key":"xT8ntKqa71"},{"type":"outputs","id":"wYntcpAnc3oVnwUw9PhMN","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"CPU times: user