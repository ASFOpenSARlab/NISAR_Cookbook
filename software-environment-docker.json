e3\"\ndisplay_name = f'\"{env_name} (Python)\"'\n\n!pixi run -e isce3 python -m ipykernel install \\\n  --user \\\n  --name $env_name \\\n  --display-name $display_name","key":"p3JwCYyGPP"},{"type":"outputs","id":"hvZte8RMLhrdx3EG5WHlm","children":[],"key":"CjsVa5oo1W"}],"identifier":"0dccb9db-969f-498c-bcce-2e667773fca4","html_id":"0dccb9db-969f-498c-bcce-2e667773fca4","key":"UrPkwMBtxH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2d. Ensure notebook shell commands run in the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OdkBY46RIY"},{"type":"inlineCode","value":"isce3","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KUgznLdZKn"},{"type":"text","value":" environment","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BHr3sjYe7F"}],"identifier":"id-2d-ensure-notebook-shell-commands-run-in-the-isce3-environment","label":"2d. Ensure notebook shell commands run in the isce3 environment","html_id":"id-2d-ensure-notebook-shell-commands-run-in-the-isce3-environment","implicit":true,"key":"mNksmdO24b"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This ensures that shell commands executed from inside a notebook with ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"btZkiSf9og"},{"type":"inlineCode","value":"!","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pLW7KABKRs"},{"type":"text","value":" run in the notebook kernel’s environment. This works by launching the entire Jupyter kernel process inside the Pixi environment, so the kernel’s PATH, environment variables, and Python executable all come from that Pixi environment, not from the parent JupyterLab environment.","position":{"start":{"line":3,"colu