\"\ndisplay_name = f'\"{env_name} (Python)\"'\n\n!pixi run -e isce3 python -m ipykernel install \\\n  --user \\\n  --name $env_name \\\n  --display-name $display_name","key":"qCesbtoTOl"},{"type":"outputs","id":"mw8uNfUC-NFSDzrz1-BsR","children":[],"key":"QLTvuDsVXN"}],"identifier":"0dccb9db-969f-498c-bcce-2e667773fca4","html_id":"0dccb9db-969f-498c-bcce-2e667773fca4","key":"yJUGd0PxEW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2d. Ensure notebook shell commands run in the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VSRjS9EDwU"},{"type":"inlineCode","value":"isce3","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wNxz42DNtg"},{"type":"text","value":" environment","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kPa1n9Helh"}],"identifier":"id-2d-ensure-notebook-shell-commands-run-in-the-isce3-environment","label":"2d. Ensure notebook shell commands run in the isce3 environment","html_id":"id-2d-ensure-notebook-shell-commands-run-in-the-isce3-environment","implicit":true,"key":"agOdTwsCJr"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This ensures that shell commands executed from inside a notebook with ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BKw1A3lVbg"},{"type":"inlineCode","value":"!","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uG9YNs5pw4"},{"type":"text","value":" run in the notebook kernel’s environment. This works by launching the entire Jupyter kernel process inside the Pixi environment, so the kernel’s PATH, environment variables, and Python executable all come from that Pixi environment, not from the parent JupyterLab environment.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FoNWHOc9Ym"}],"key":"cWbkDxjXF3"}],"identifier":"6aabd21a-d788-4aec-b439-2da458002c9c","html_id":"6aabd21a-d788-4aec-b439-2da458002c9c","key":"icdNMPdHtj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from jupyter_client.kernelspec import KernelSpecManager\nimport json\n\nksm = KernelSpecManager()\nspec = ksm.get_kernel_spec(env_name)\nkernel_dir = Path(spec.resource_dir)\nkernel_json = kernel_dir / \"kernel.json\"\n\ndata = json.loads(kernel_json.read_text())\norig_argv = data.get(\"argv\", [])\n\nnew_argv = [\n    \"pixi\",\n    \"run\",\n    \"--manifest-path\",\n    str(Path.cwd().parent),\n    \"-e\",\n    env_name,\n] + orig_argv\n\ndata[\"argv\"] = new_argv\nkernel_json.write_text(json.dumps(data, indent=2))\nprint(f\"Updated kernel.json at {kernel_json} with Pixi wrapper.\")\nprint(\"argv:\", data[\"argv\"])","key":"UMkjwX9p5E"},{"type":"outputs","id":"rLiZjoyJwJ8s-jrEf_p7u","children":[],"key":"Sd0nzWrYTp"}],"identifier":"5fcbcd90-8d82-4e26-a094-bf480b273630","html_id":"5fcbcd90-8d82-4e26-a094-bf480b273630","key":"kbz17N5Hkk"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2e. (Optional) Delete the environment and remove its ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QJxor7V6Yl"},{"type":"inlineCode","value":"kernelspec","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WR2aYq6zZx"}],"identifier":"id-2e-optional-delete-the-environment-and-remove-its-kernelspec","label":"2e. (Optional) Delete the environment and remove its kernelspec","html_id":"id-2e-optional-delete-the-environment-and-remove-its-kernelspec","implicit":true,"key":"MHOtw6rQMf"}],"identifier":"31630500-f508-41d3-9e5e-84a2e5618c59","html_id":"31630500-f508-41d3-9e5e-84a2e5618c59","key":"