xample was copied from the ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"QTj2dKguWX"},{"type":"link","url":"https://nisar-docs.asf.alaska.edu/earthaccess/","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"NISAR Data User Guide","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"KZyUr6y8pM"}],"urlSource":"https://nisar-docs.asf.alaska.edu/earthaccess/","key":"QQp2bFiZsr"}],"key":"f3NNFxzHkz"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Direct S3 access only works when running in the AWS ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"ppKRIdgm3n"},{"type":"inlineCode","value":"us-west-2","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"rDy6AGTA6v"},{"type":"text","value":" region.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"t1CfYrUmyi"}],"key":"ElNjNWoIf7"}],"key":"W7sx7oRkMS"}],"identifier":"1e071dbc-fe02-4cf4-9bea-0a5aa10794d9","html_id":"1e071dbc-fe02-4cf4-9bea-0a5aa10794d9","key":"V400D42Bl2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Notes on Chunking","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QhEcfyJ81O"}],"identifier":"notes-on-chunking","label":"Notes on Chunking","html_id":"notes-on-chunking","implicit":true,"key":"NLXgteyrIc"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This notebook utilizes chunking to break large arrays into smaller blocks. Chunking allows users to inspect and process subsets of a dataset without loading entire arrays into memory at once. In this example, data are accessed using an 8 MB block size for cloud access.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"StYtX7zIdP"}],"key":"RvNKVjTva9"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"For additional benchmarking and recommendations for NISAR direct-access workflows, see Henry Rodman’s ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"NSaKJ9Vizk"},{"type":"link","url":"https://gist.github.com/hrodmn/5a377531c19da6f6d2c2bb149c450b3d","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Reading NISAR granules directly from S3","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"UayrZ7POua"}],"urlSource":"https://gist.github.com/hrodmn/5a377531c19da6f6d2c2bb149c450b3d","key":"P2di9BR1c6"},{"type":"text","value":".","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"bDXrwaopXM"}],"key":"htVeY0dJ88"}],"identifier":"5c828ed3-a277-4535-832c-033b095a3176","html_id":"5c828ed3-a277-4535-832c-033b095a3176","key":"Xc2atKOxVA"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"%%time\n\nimport earthaccess\nimport xarray as xr\n\ns3_links = results[0].data_links(access='direct')\n\nfsspec_config = {\n    'cache_type': 'background',\n    'block_size': 8*1024*1024,  # 8 MB\n}\n\n# The endpoint must be set to the NISAR-specific endpoint\nendpoint = 'https://nisar.asf.earthdatacloud.nasa.gov/s3credentials'\nfs = earthaccess.get_s3_filesystem(endpoint=endpoint)\nds = xr.open_datatree(\n   fs.open(s3_links[0], **fsspec_config),\n   engine='h5netcdf',\n   decode_timedelta=False,\n   phony_dims=\"access\"\n)\n\nds","key":"yLBDlexg0B"},{"type":"outputs","id":"Wt8DrK-LbwvZLYbNM2SLa","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"CPU times: user