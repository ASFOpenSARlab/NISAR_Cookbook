g an 8 MB block size for cloud access.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qlvaCeiZ2N"}],"key":"u9IPf8vdki"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"For additional benchmarking and recommendations for NISAR direct-access workflows, see Henry Rodman’s ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"vfg0rfYZri"},{"type":"link","url":"https://gist.github.com/hrodmn/5a377531c19da6f6d2c2bb149c450b3d","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Reading NISAR granules directly from S3","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"rpWBHdKveN"}],"urlSource":"https://gist.github.com/hrodmn/5a377531c19da6f6d2c2bb149c450b3d","key":"TXKL32BBpL"},{"type":"text","value":".","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"eBWM7xKsbu"}],"key":"BzBf5XhudG"}],"identifier":"5c828ed3-a277-4535-832c-033b095a3176","html_id":"5c828ed3-a277-4535-832c-033b095a3176","key":"ubWyvDJ1GJ"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"%%time\n\nimport earthaccess\nimport xarray as xr\n\ns3_links = results[0].data_links(access='direct')\n\nfsspec_config = {\n    'cache_type': 'background',\n    'block_size': 8*1024*1024,  # 8 MB\n}\n\n# The endpoint must be set to the NISAR-specific endpoint\nendpoint = 'https://nisar.asf.earthdatacloud.nasa.gov/s3credentials'\nfs = earthaccess.get_s3_filesystem(endpoint=endpoint)\nds = xr.open_datatree(\n   fs.open(s3_links[0], **fsspec_config),\n   engine='h5netcdf',\n   decode_timedelta=False,\n   phony_dims=\"access\"\n)\n\nds","key":"RKDFuPwb6K"},{"type":"outputs","id":"N1nfbuPC3YEicQZA3EzA9","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"CPU tim