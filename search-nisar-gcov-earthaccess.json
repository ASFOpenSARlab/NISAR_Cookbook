xample was copied from the ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"tlXzstZ092"},{"type":"link","url":"https://nisar-docs.asf.alaska.edu/earthaccess/","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"NISAR Data User Guide","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"VuiTvgqSeo"}],"urlSource":"https://nisar-docs.asf.alaska.edu/earthaccess/","key":"GRXNFwaEnz"}],"key":"nP6u6pOevZ"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Direct S3 access only works when running in the AWS ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"liXayX5FHv"},{"type":"inlineCode","value":"us-west-2","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"zOB3b40kdm"},{"type":"text","value":" region.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"nZFS9m3yz7"}],"key":"OPiYxfEIv9"}],"key":"gbPCJtOlgu"}],"identifier":"1e071dbc-fe02-4cf4-9bea-0a5aa10794d9","html_id":"1e071dbc-fe02-4cf4-9bea-0a5aa10794d9","key":"h4WkMsjYlW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Notes on Chunking","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vehELj18iD"}],"identifier":"notes-on-chunking","label":"Notes on Chunking","html_id":"notes-on-chunking","implicit":true,"key":"nJmBgBVyGR"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This notebook utilizes chunking to break large arrays into smaller blocks. Chunking allows users to inspect and process subsets of a dataset without loading entire arrays into memory at once. In this example, data are accessed using an 8 MB block size for cloud access.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pjvMbIAVQi"}],"key":"pAtYyX8Ssu"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"For additional benchmarking and recommendations for NISAR direct-access workflows, see Henry Rodman’s ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"l3cPj3nF7G"},{"type":"link","url":"https://gist.github.com/hrodmn/5a377531c19da6f6d2c2bb149c450b3d","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Reading NISAR granules directly from S3","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"gaoHVLl70i"}],"urlSource":"https://gist.github.com/hrodmn/5a377531c19da6f6d2c2bb149c450b3d","key":"yus1fZcsgS"},{"type":"text","value":".","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"LnnXXVkz3s"}],"key":"cnB4qphEr3"}],"identifier":"5c828ed3-a277-4535-832c-033b095a3176","html_id":"5c828ed3-a277-4535-832c-033b095a3176","key":"GZ6ZLEo1q4"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"%%time\n\nimport earthaccess\nimport xarray as xr\n\ns3_links = results[0].data_links(access='direct')\n\nfsspec_config = {\n    'cache_type': 'background',\n    'block_size': 8*1024*1024,  # 8 MB\n}\n\n# The endpoint must be set to the NISAR-specific endpoint\nendpoint = 'https://nisar.asf.earthdatacloud.nasa.gov/s3credentials'\nfs = earthaccess.get_s3_filesystem(endpoint=endpoint)\nds = xr.open_datatree(\n   fs.open(s3_links[0], **fsspec_config),\n   engine='h5netcdf',\n   decode_timedelta=False,\n   phony_dims=\"access\"\n)\n\nds","key":"aSlO3PmOdo"},{"type":"outputs","id":"1sQYOeTYBFNxDZtYo5wDE","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"CPU times: user